# 数据库配置
DATABASE_URL="postgresql://postgres:password@localhost:5432/xcpc_oj?schema=public"
# JWT密钥
JWT_SECRET="novajudge-jwt-secret"
# 生产模式
NODE_ENV="production"
# 超级管理员账号密码
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="123456"
# Go-Judge 接口地址 (默认本地端口)
GO_JUDGE_API="http://localhost:5050"
# 单台判题机（worker 进程）的并发判题数，按 CPU 核心数调整
JUDGE_CONCURRENCY=4
# 判题机 ID（可选）：多开时可通过命令行 --id 指定，留空则自动分配
# JUDGE_ID=1
# 多开判题机数量（npm run worker:multi 使用，默认 2）
# JUDGE_WORKER_COUNT=4
# 多开判题机的 ID 列表（npm run worker:multi 使用，如 1,2,3）
# JUDGE_WORKER_IDS=1,2,3
# Redis 配置
REDIS_URL="redis://localhost:6379"
# Web 服务公开地址，供 CLI 自动登录等功能使用
NOVAJUDGE_URL="http://localhost:3001"
