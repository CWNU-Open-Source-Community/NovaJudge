# 数据库配置：填写真实密码，并保持 POSTGRES_PASSWORD 与 DATABASE_URL 一致。
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="xcpc_oj"
DATABASE_URL=""
# JWT密钥
JWT_SECRET=""
# 生产模式
NODE_ENV="production"
# 超级管理员账号密码
SUPER_ADMIN_USERNAME=""
SUPER_ADMIN_PASSWORD=""
# Go-Judge 接口地址 (默认本地端口)
GO_JUDGE_API="http://localhost:5050"
# 可选；HTTP 请求至少覆盖沙箱运行兜底时间再加 60 秒。
# GO_JUDGE_REQUEST_TIMEOUT_MS=120000
# 多主机 Worker 可指定共享题目目录，内容应与 Web 的 uploads/problems 相同。
# PROBLEM_DATA_ROOT="/mnt/novajudge/problems"
# 单台判题机（worker 进程）的并发判题数，按 CPU 核心数调整
JUDGE_CONCURRENCY=4
# 运行兜底的最小实际经过时间（毫秒），最终取 max(此值, 20 × CPU 时限)。
# 仅防止卡死占用判题机；CPU 未超限时触发兜底会记为 SYSTEM_ERROR，不判 TLE。
JUDGE_WALL_WATCHDOG_MS=60000
# 判题机 ID（可选）：多开时可通过命令行 --id 指定，留空则自动分配
# JUDGE_ID=1
# 多开判题机数量（npm run worker:multi 使用，默认 2）
# JUDGE_WORKER_COUNT=4
# 多开判题机的 ID 列表（npm run worker:multi 使用，如 1,2,3）
# JUDGE_WORKER_IDS=1,2,3
# Redis 配置
REDIS_URL="redis://localhost:6379"
# Web 服务公开地址，供 CLI 自动登录等功能使用
NOVAJUDGE_URL="http://localhost:3001"
# submit 仅在内网部署显式启用：改为 intranet 后重启 Web 服务，再在后台选择命令行比赛。
# 公网及默认部署保持 public；不影响网页提交和监考登录。
NOVAJUDGE_CLI_MODE="public"

# 外部登录：新站点默认关闭。填写认证地址后，在后台设置中启用。
# 现有私服升级会保留数据库中的开关与账号状态。
EXTERNAL_AUTH_URL=""
APP_KEY=""

# 站点配置：无需维护学校专用代码分支。修改后重新构建并重启 Web。
NOVAJUDGE_SITE_NAME="NovaJudge"
NOVAJUDGE_SITE_DESCRIPTION="XCPC Online Judge"
NOVAJUDGE_FOOTER_TEXT=""
# 可选：使用部署目录外的组织映射 JSON，默认 config/org-map.json。
# NOVAJUDGE_ORG_MAP_PATH="/etc/novajudge/org-map.json"
